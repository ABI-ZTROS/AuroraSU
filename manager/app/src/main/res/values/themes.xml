<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base AuroraSU Theme -->
    <style name="Theme.AuroraSU" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Primary Colors -->
        <item name="android:colorPrimary">@color/aurora_primary</item>
        <item name="android:colorPrimaryDark">@color/aurora_primary</item>
        <item name="android:colorAccent">@color/aurora_primary</item>
        
        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/aurora_primary</item>
        <item name="android:navigationBarColor">@color/aurora_primary</item>
    </style>
    
    <!-- Splash Screen Theme -->
    <style name="Theme.AuroraSU.Starting" parent="Theme.AuroraSU">
        <item name="android:windowBackground">@color/aurora_primary</item>
    </style>
</resources>
